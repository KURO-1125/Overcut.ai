# Overcut.ai environment template — copy to .env and edit.
# backend/core/config.py loads this file without overriding real env vars.

# development | production
OVERCUT_ENV=development

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
OVERCUT_JWT_SECRET=

# Optional shared API key. When set, every /api request must send X-API-Key.
OVERCUT_API_KEY=

# Comma-separated browser origins allowed by CORS.
OVERCUT_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Mutable state (FAISS index, SQLite metadata, parquet cache, ROI crops).
# OVERCUT_DATA_DIR=./data
# OVERCUT_MODELS_DIR=./models

# Optional MongoDB. Without it, auth endpoints return an explicit 503.
OVERCUT_MONGO_URI=

# Optional cloud VLM providers (server-side only; never expose in the frontend).
GEMINI_API_KEY=
OPENAI_API_KEY=

# Real F1 telemetry source. OpenF1 (api.openf1.org) serves 2025/2026 sessions
# without authentication at ~4 Hz; set to "off" to force the synthetic path.
OVERCUT_OPENF1=auto
OVERCUT_OPENF1_TIMEOUT=6

# Concurrency cap for heavy analyses (VLM / matplotlib).
OVERCUT_MAX_CONCURRENT_ANALYSES=2
